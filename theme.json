{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "color": {
      "palette": [
        {
          "slug": "primary",
          "color": "#525ddc",
          "name": "Primary"
        }
      ],
      "custom": false,
      "customGradient": false,
      "defaultPalette": false,
      "defaultGradients": false
    },
    "custom": {
      "spacing": {},
      "typography": {
        "font-size": {},
        "line-height": {}
      }
    },
    "spacing": {
      "padding": true,
      "margin": true,
      "units": ["px"]
    },
    "layout": {
      "contentSize": "1380px",
      "wideSize": "1380px"
    },
    "blocks": {
    },
    "typography": {
      "customFontSize": false,
      "fontStyle": false,
      "fontWeight": false,
      "dropCap": false,
      "letterSpacing": false,
      "fontSizes": [
        {
          "name": "Small",
          "slug": "small",
          "size": "1rem"
        },
        {
          "name": "Medium",
          "slug": "medium",
          "size": "1.125rem"
        },
        {
          "name": "Large",
          "slug": "large",
          "size": "2.27rem"
        },
        {
          "name": "Extra Large",
          "slug": "x-large",
          "size": "3rem"
        }
      ]
    }
  }
}
